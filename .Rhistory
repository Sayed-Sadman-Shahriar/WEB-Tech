df_nmes$married<-ifelse(df_nmes$married=="yes",1,0)
df_nmes$employed<-ifelse(df_nmes$employed=="yes",1,0)
df_nmes$insurance<-ifelse(df_nmes$insurance=="yes",1,0)
df_nmes$medicaid<-ifelse(df_nmes$medicaid=="yes",1,0)
